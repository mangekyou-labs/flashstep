# Template for NextJS environment variables.

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# If not set, we provide default values (check `scaffold.config.ts`) so developers can start prototyping out of the box,
# but we recommend getting your own API Keys for Production Apps.

# To access the values stored in this env file you can use: process.env.VARIABLENAME
# You'll need to prefix the variables names with NEXT_PUBLIC_ if you want to access them on the client side.
# More info: https://nextjs.org/docs/pages/building-your-application/configuring/environment-variables
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=


# Rounds page (/rounds). Contract addresses are build-time config; see docs/rounds/.
# Block explorer base URL used for settle-transaction links, e.g. https://sepolia.basescan.org.
# NEXT_PUBLIC_<PAYER>_EXPLORER_URL (DEGEN, BASE) overrides the shared value for one payer. With none set,
# local chains show plain transaction hashes and Base (8453) / Base Sepolia (84532) use BaseScan.
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_DEGEN_EXPLORER_URL=
NEXT_PUBLIC_BASE_EXPLORER_URL=
# Server-side (not NEXT_PUBLIC_). Space-separated origins allowed to embed /rounds in an iframe;
# unset allows any site. Example: "https://degen.example https://www.degen.example".
ROUNDS_FRAME_ANCESTORS=

# Payer Campaign stats (/rounds/stats): Campaign cost in the stake token (unset shows "not configured"), and the first block to read events from.
NEXT_PUBLIC_DEGEN_CAMPAIGN_COST=
NEXT_PUBLIC_DEGEN_FROM_BLOCK=0
NEXT_PUBLIC_BASE_CAMPAIGN_COST=
NEXT_PUBLIC_BASE_FROM_BLOCK=0
